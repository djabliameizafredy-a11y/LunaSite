# --- Supabase (production / staging) ---
# Remplacer [YOUR-PASSWORD] par le mot de passe de la base (URL-encodé : @ -> %40, # -> %23, / -> %2F, : -> %3A, ? -> %3F, & -> %26, % -> %25).
# DATABASE_URL = pooler mode transaction (port 6543), utilisée par l'API (pgbouncer=true).
# DIRECT_URL    = pooler mode session (port 5432), utilisée par la CLI Prisma (migrate, seed, studio) : le mode transaction casse `migrate`.
DATABASE_URL="postgresql://postgres.srwfjmjbsjbjdpffinwi:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.srwfjmjbsjbjdpffinwi:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

