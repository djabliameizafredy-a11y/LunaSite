{
  "name": "lunasite",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "npm run dev -w @lunasite/api",
    "api:test": "npm run test -w @lunasite/api",
    "web:dev": "npm run dev -w @lunasite/web",
    "web:build": "npm run build -w @lunasite/web"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "@prisma/client@7.10.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
